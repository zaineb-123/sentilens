# Copy to .env and replace every placeholder. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# ---- MongoDB
MONGO_ROOT_USER=sentilens_root
MONGO_ROOT_PASSWORD=replace-me-with-a-long-random-value

# ---- AI service
AI_ENGINE=transformers          # transformers (real models) | lexicon (dev/tests only)
AI_MODEL_PROFILE=light          # light = sentiment+emotion | full = + embedding aspect matching (more RAM)
AI_PRELOAD_MODELS=true          # download models at image build time
AI_INTERNAL_KEY=replace-me-internal-service-key
AI_PORT=8000

# ---- Shared JWT / internal secrets (Auth, Organization, and later services)
JWT_ACCESS_SECRET=replace-me-jwt-access-secret
JWT_REFRESH_SECRET=replace-me-jwt-refresh-secret
INTERNAL_SERVICE_KEY=replace-me-internal-service-key

# ---- Seed script (seed/seed.js) - only needed when running the seed script from your host
MONGO_HOST=localhost:27017
GATEWAY_URL=http://localhost:8080
